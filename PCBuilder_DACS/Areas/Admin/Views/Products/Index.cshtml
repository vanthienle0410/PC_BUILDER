@model IEnumerable<PCBuilder_DACS.Models.Product>
@{
    ViewData["Title"] = "Quản lý Kho Hàng";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i>Danh Sách Linh Kiện</h4>
    <a asp-action="Create" class="btn btn-primary px-4">
        <i class="bi bi-plus-circle me-1"></i> Thêm Linh Kiện Mới
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:60px">ID</th>
                        <th style="width:80px">Ảnh</th>
                        <th>Tên Linh Kiện</th>
                        <th>Danh Mục</th>
                        <th>Giá (VNĐ)</th>
                        <th class="text-center">AI Gợi Ý</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center" style="width:200px">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.IsActive ? "table-secondary" : "")">
                            <td class="text-muted">#@item.ProductId</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.ProductName"
                                         class="rounded" style="width:56px;height:56px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                         style="width:56px;height:56px;">
                                        <i class="bi bi-image text-muted fs-4"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td><span class="badge bg-secondary">@(item.Category?.CategoryName ?? "N/A")</span></td>
                            <td class="text-danger fw-bold">@(item.Price?.ToString("N0") ?? "—")</td>
                            <td class="text-center">
                                @if (item.IsHiddenFromRecommendation)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-eye-slash"></i> Đang Ẩn</span>
                                }
                                else
                                {
                                    <span class="badge bg-info"><i class="bi bi-robot"></i> Đang Gợi Ý</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Đang Bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Đã Ẩn</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.ProductId"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                @if (item.IsActive)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" class="d-inline"
                                          onsubmit="return confirm('Xác nhận ẩn linh kiện này khỏi cửa hàng?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-eye-slash"></i> Ẩn
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Restore" asp-route-id="@item.ProductId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-arrow-counterclockwise"></i> Khôi Phục
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
