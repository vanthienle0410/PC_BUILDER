@model IEnumerable<PCBuilder_DACS.Models.ApplicationUser>

@{
    ViewData["Title"] = "Quản lý Tài khoản";
    var userRoles = ViewBag.UserRoles as System.Collections.Generic.Dictionary<int, string>;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản lý Tài khoản</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin">Dashboard</a></li>
        <li class="breadcrumb-item active">Tài khoản</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-users me-1"></i>
            Danh sách người dùng
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered" id="datatablesSimple">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Hạng</th>
                        <th>Điểm</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isLocked = item.LockoutEnd != null && item.LockoutEnd > DateTimeOffset.Now;
                        var roles = userRoles != null && userRoles.ContainsKey(item.Id) ? userRoles[item.Id] : "Customer";
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Email</td>
                            <td>
                                @if(roles.Contains("Admin"))
                                {
                                    <span class="text-muted small">Không áp dụng</span>
                                }
                                else
                                {
                                    @if(item.Tier == PCBuilder_DACS.Models.MembershipTier.Bronze) { <span class="badge bg-secondary">Đồng</span> }
                                    else if(item.Tier == PCBuilder_DACS.Models.MembershipTier.Silver) { <span class="badge bg-light text-dark border">Bạc</span> }
                                    else if(item.Tier == PCBuilder_DACS.Models.MembershipTier.Gold) { <span class="badge bg-warning text-dark">Vàng</span> }
                                    else if(item.Tier == PCBuilder_DACS.Models.MembershipTier.Diamond) { <span class="badge bg-info text-dark">Kim Cương</span> }
                                }
                            </td>
                            <td>@item.TotalPoints</td>
                            <td>
                                <span class="badge @(roles.Contains("Admin") ? "bg-danger" : "bg-primary")">@roles</span>
                            </td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge bg-danger">Bị Khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white"><i class="fas fa-eye"></i></a>
                                
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này không? Mọi dữ liệu liên quan có thể bị mất.');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Xóa tài khoản">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>

                                <button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#roleModal-@item.Id" title="Đổi quyền">
                                    <i class="fas fa-user-cog"></i>
                                </button>
                                
                                <!-- Modal Role -->
                                <div class="modal fade" id="roleModal-@item.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Phân quyền: @item.Email</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="AssignRole" asp-route-id="@item.Id" method="post">
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label">Vai trò mới</label>
                                                        <select name="role" class="form-select">
                                                            <option value="Customer" selected="@(roles.Contains("Customer"))">Khách hàng (Customer)</option>
                                                            <option value="Admin" selected="@(roles.Contains("Admin"))">Quản trị viên (Admin)</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
