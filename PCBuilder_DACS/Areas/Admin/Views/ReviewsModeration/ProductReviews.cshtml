@model IEnumerable<PCBuilder_DACS.Models.ProductReview>

@{
    ViewData["Title"] = "Kiểm Soát Đánh Giá - " + ViewBag.ProductName;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi tiết đánh giá</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">AI Feedback Loop</a></li>
        <li class="breadcrumb-item active">@ViewBag.ProductName</li>
    </ol>

    <div class="card mb-4 shadow-sm border-0 rounded-4">
        <div class="card-header bg-white pt-3 pb-2 px-4 d-flex justify-content-between align-items-center">
            <span class="fw-bold fs-5 text-primary">
                <i class="bi bi-chat-left-text me-2"></i>@ViewBag.ProductName
            </span>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </a>
        </div>
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-slash text-muted" style="font-size: 3rem;"></i>
                    <p class="mt-3 text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Người dùng</th>
                                <th>Đánh giá</th>
                                <th>Nội dung</th>
                                <th>AI Sentiment</th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@(item.User?.UserName ?? "Ẩn danh")</div>
                                        <div class="small text-muted">@(item.User?.Email ?? "")</div>
                                    </td>
                                    <td>
                                        <div class="text-warning text-nowrap">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= (item.Rating ?? 5) ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                    </td>
                                    <td style="max-width: 300px;">
                                        <p class="mb-0 text-break">@item.Content</p>
                                    </td>
                                    <td>
                                        @if (item.Sentiment == "Positive")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-emoji-smile me-1"></i>Tích cực</span>
                                        }
                                        else if (item.Sentiment == "Negative")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-emoji-frown me-1"></i>Tiêu cực</span>
                                        }
                                    </td>
                                    <td>
                                        @item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (item.IsHidden)
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-eye-slash me-1"></i>Đã Ẩn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary rounded-pill px-3 py-2"><i class="bi bi-eye me-1"></i>Hiển Thị</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="ToggleReviewVisibility" method="post">
                                            <input type="hidden" name="id" value="@item.ReviewId" />
                                            <input type="hidden" name="productId" value="@ViewBag.ProductId" />
                                            @if (item.IsHidden)
                                            {
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" title="Bỏ ẩn đánh giá này">
                                                    <i class="bi bi-eye me-1"></i>Hiện
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-warning rounded-pill px-3 shadow-sm text-dark" title="Ẩn đánh giá này khỏi Shop">
                                                    <i class="bi bi-eye-slash me-1"></i>Ẩn
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
