@model PCBuilder_DACS.Models.Order
@{
    ViewData["Title"] = $"Chi Tiết Đơn #{Model.OrderId}";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="mb-0 fw-bold">
        <i class="bi bi-receipt me-2 text-primary"></i>Đơn Hàng #@Model.OrderId
    </h4>
    <div class="ms-3">
        @switch (Model.Status)
        {
            case "Pending":
                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-clock me-1"></i>Chờ xử lý</span>
                break;
            case "Shipping":
                <span class="badge bg-primary fs-6"><i class="bi bi-truck me-1"></i>Đang giao</span>
                break;
            case "Completed":
                <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Hoàn thành</span>
                break;
            case "Cancelled":
                <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                break;
            case "Returned":
                <span class="badge bg-secondary fs-6"><i class="bi bi-arrow-return-left me-1"></i>Đã trả hàng</span>
                break;
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">

    <!-- Thông tin khách hàng -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="bi bi-person-circle me-2"></i>Thông Tin Khách Hàng
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted" style="width:120px">Tên tài khoản</td>
                        <td class="fw-semibold">@Model.User?.UserName</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Email</td>
                        <td>@Model.User?.Email</td>
                    </tr>
                    <tr>
                        <td class="text-muted">SĐT nhận hàng</td>
                        <td>@(string.IsNullOrEmpty(Model.ReceiverPhone) ? "Chưa cung cấp" : Model.ReceiverPhone)</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Địa chỉ</td>
                        <td>@(string.IsNullOrEmpty(Model.ShippingAddress) ? "Chưa cung cấp" : Model.ShippingAddress)</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Ngày đặt</td>
                        <td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Bảng linh kiện -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="bi bi-cpu me-2"></i>Cấu Hình PC Đã Đặt
            </div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px">Ảnh</th>
                            <th>Linh Kiện</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn Giá</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    @{
                                        string rawPath = item.Product?.ImagePath ?? "";
                                        string resolvedImage = (rawPath.StartsWith("http://") || rawPath.StartsWith("https://"))
                                            ? rawPath
                                            : (string.IsNullOrEmpty(rawPath) ? Url.Content("~/images/default.png") : Url.Content("~/images/" + rawPath));
                                    }
                                    <img src="@resolvedImage" class="rounded"
                                         style="width:50px;height:50px;object-fit:cover;"
                                         onerror="this.onerror=null; this.src='@Url.Content("~/images/default.png")';" />
                                </td>
                                <td class="fw-semibold">@item.Product?.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                                <td class="text-end text-danger fw-bold">
                                    @((item.Quantity * item.UnitPrice).ToString("N0")) ₫
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="4" class="text-end fw-semibold">Tạm tính:</td>
                                <td class="text-end">
                                    @((Model.TotalAmount + Model.DiscountAmount).ToString("N0")) ₫
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end fw-semibold text-success">Chiết khấu thành viên:</td>
                                <td class="text-end text-success">
                                    -@Model.DiscountAmount.ToString("N0") ₫
                                </td>
                            </tr>
                        }
                        <tr>
                            <td colspan="4" class="text-end fw-bold fs-6">Tổng Cộng:</td>
                            <td class="text-end text-danger fw-bold fs-5">
                                @Model.TotalAmount.ToString("N0") ₫
                            </td>
                        </tr>
                        @if (Model.IsPointsAwarded)
                        {
                            <tr>
                                <td colspan="5" class="text-end text-primary small pt-2">
                                    <i class="bi bi-star-fill me-1"></i>Đã cộng <strong>@((int)(Model.TotalAmount / 100000))</strong> điểm tích lũy cho khách hàng.
                                </td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Action Area: Cập nhật trạng thái -->
    <div class="col-12">
        <div class="card border-0 shadow-sm border-start border-4 border-warning">
            <div class="card-body d-flex align-items-center gap-4 flex-wrap">
                <div>
                    <h6 class="fw-bold mb-0"><i class="bi bi-arrow-repeat me-2 text-warning"></i>Cập Nhật Trạng Thái Đơn Hàng</h6>
                    <small class="text-muted">Chọn trạng thái phù hợp và nhấn cập nhật</small>
                </div>
                <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-3 ms-auto">
                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                    <select name="status" class="form-select" style="min-width:200px;">
                        @{
                            var statuses = new[] {
                                ("Pending",   "⏳ Chờ xử lý"),
                                ("Shipping",  "🚚 Đang giao hàng"),
                                ("Completed", "✅ Hoàn thành"),
                                ("Cancelled", "❌ Hủy đơn"),
                                ("Returned",  "🔄 Trả hàng")
                            };
                            foreach (var (val, label) in statuses)
                            {
                                if (val == Model.Status)
                                {
                                    <option value="@val" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@val">@label</option>
                                }
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-warning fw-bold px-4">
                        <i class="bi bi-save me-1"></i>Cập Nhật
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
