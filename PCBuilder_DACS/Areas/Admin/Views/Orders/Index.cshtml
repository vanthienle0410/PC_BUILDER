@model IEnumerable<PCBuilder_DACS.Models.Order>
@{
    ViewData["Title"] = "Quản lý Đơn Hàng";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">
        <i class="bi bi-cart-check me-2 text-primary"></i>Danh Sách Đơn Hàng
    </h4>
    <span class="badge bg-secondary fs-6">@Model.Count() đơn</span>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:80px">Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Email</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center" style="width:130px">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Chưa có đơn hàng nào
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-primary">#@order.OrderId</span>
                                    @if (order.PaymentMethod == "Trả góp")
                                    {
                                        <br/><span class="badge bg-warning text-dark mt-1" style="font-size: 0.7rem;"><i class="bi bi-credit-card me-1"></i>Trả Góp - @order.InstallmentMonths Tháng</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                             style="width:36px;height:36px;font-size:.85rem;font-weight:700;">
                                            @(order.User?.UserName?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <span class="fw-semibold">@(order.User?.UserName ?? "Không rõ")</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@(order.User?.Email ?? "—")</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-danger fw-bold">@order.TotalAmount.ToString("N0") ₫</td>
                                <td class="text-center">
                                    @switch (order.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock me-1"></i>Chờ xử lý
                                            </span>
                                            break;
                                        case "Shipping":
                                            <span class="badge bg-primary">
                                                <i class="bi bi-truck me-1"></i>Đang giao
                                            </span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Hoàn thành
                                            </span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@order.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@order.OrderId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>Chi Tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
