@model IEnumerable<PCBuilder_DACS.Models.Product>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-cart4 me-2 text-primary"></i>Giỏ hàng của bạn</h2>
        <a href="/Home/BuildPC" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="bi bi-plus-lg me-1"></i>Thêm linh kiện
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 shadow-sm rounded-4 bg-white border">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <p class="mt-3 text-muted fs-5">Giỏ hàng đang trống Bạn ơi!</p>
            <a href="/Home/BuildPC" class="btn btn-primary rounded-pill px-4 shadow-sm">Đến trang Build PC</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 py-3 text-secondary">Sản phẩm</th>
                                    <th class="py-3 text-secondary">Đơn giá</th>
                                    <th class="py-3 text-center text-secondary">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-4">
                                            <div class="d-flex align-items-center gap-3">
                                                @{
                                                    string rawPath = item.ImagePath ?? "";
                                                    string resolvedImage = (rawPath.StartsWith("http://") || rawPath.StartsWith("https://"))
                                                        ? rawPath
                                                        : (string.IsNullOrEmpty(rawPath) ? Url.Content("~/images/default.png") : Url.Content("~/images/" + rawPath));
                                                }
                                                <img src="@resolvedImage" class="rounded shadow-sm"
                                                     style="width:50px;height:50px;object-fit:contain;background:#f8f9fa;"
                                                     onerror="this.onerror=null; this.src='@Url.Content("~/images/default.png")';" />
                                                <div>
                                                    <div class="fw-bold text-dark">@item.ProductName</div>
                                                    <small class="text-muted">ID: #@item.ProductId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4 fw-bold text-danger">
                                            @((item.Price ?? 0).ToString("N0")) đ
                                        </td>
                                        <td class="py-4 text-center">
                                            <button class="btn btn-outline-danger border-0 rounded-circle p-2"
                                                    onclick="removeItem(@item.ProductId)">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 20px;">
                    <h5 class="fw-bold mb-3 text-dark">Tóm tắt cấu hình</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Số lượng linh kiện:</span>
                        <span class="fw-bold">@Model.Count() món</span>
                    </div>
                    <hr class="text-muted">
                    <div class="d-flex justify-content-between align-items-end mb-4">
                        <span class="fw-bold text-dark">Tổng cộng:</span>
                        <h3 class="text-danger fw-bold mb-0">
                            @((Model.Sum(p => p.Price) ?? 0).ToString("N0")) đ
                        </h3>
                    </div>
                    <a asp-controller="Cart" asp-action="Checkout"
                       class="btn btn-success w-100 rounded-pill py-3 fw-bold shadow-sm mb-3">
                        TIẾN HÀNH THANH TOÁN <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                    <p class="text-center small text-muted mb-0">AI đã kiểm tra tính tương thích cho bộ máy này.</p>
                </div>
            </div>
        </div>
    }
</div>

<script>
    async function removeItem(productId) {
        if (!confirm("Bạn chắc chắn muốn bỏ linh kiện này chứ?")) return;

        try {
            const response = await fetch('/api/Cart/remove-item', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(productId)
            });

            if (response.ok) {
                location.reload(); // Tải lại trang để cập nhật tiền
            } else {
                alert("Lỗi khi xóa sản phẩm.");
            }
        } catch (error) {
            alert("Lỗi kết nối Server.");
        }
    }
</script>