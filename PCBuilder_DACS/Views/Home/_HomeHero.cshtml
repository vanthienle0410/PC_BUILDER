                <div style="height:172px; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:16px; color:#fff; text-align:center; background: rgba(0,0,0,0.4); border-radius: 12px;">
                    <i class="bi bi-cpu-fill" style="font-size:2.5rem; color:#60d0ff; margin-bottom:8px;"></i>
                    <div style="font-size:0.75rem; font-weight:700; opacity:0.75; text-transform:uppercase;">Build Cấu Hình</div>
                    <div style="font-size:1rem; font-weight:800; margin:4px 0;">AI TƯ VẤN NGAY</div>
