@model IEnumerable<PCBuilder_DACS.Models.InstallmentSchedule>
@{
    ViewData["Title"] = "Lịch sử trả góp";
}

<div class="container py-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 mb-4">
            <div class="list-group shadow-sm" style="border-radius:12px; overflow:hidden;">
                <a href="/Profile" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-person-badge me-2"></i>Thông tin cá nhân
                </a>
                <a href="/Profile/OrderHistory" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-bag-check me-2"></i>Lịch sử mua hàng
                </a>
                <a href="/Profile/Installments" class="list-group-item list-group-item-action py-3 active fw-bold" style="background:#0065FF; border-color:#0065FF;">
                    <i class="bi bi-credit-card me-2"></i>Lịch sử trả góp
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                    <button type="submit" class="list-group-item list-group-item-action py-3 text-danger w-100 text-start border-0">
                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                    </button>
                </form>
            </div>
        </div>

        <!-- Content -->
        <div class="col-md-9">
            <div class="card border-0 shadow-sm" style="border-radius:12px;">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-credit-card text-primary me-2"></i>Lịch trình trả góp</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
                            <p class="mt-3 text-muted">Bạn chưa có khoản trả góp nào.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="py-3 px-4">Mã ĐH</th>
                                        <th class="py-3">Kỳ hạn</th>
                                        <th class="py-3">Ngày đến hạn</th>
                                        <th class="py-3 text-end">Số tiền</th>
                                        <th class="py-3 text-center">Trạng thái</th>
                                        <th class="py-3 text-center">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var schedule in Model)
                                    {
                                        var isOverdue = schedule.Status == "Unpaid" && schedule.DueDate < DateTime.Now.Date;
                                        var isUpcoming = schedule.Status == "Unpaid" && !isOverdue && schedule.DueDate <= DateTime.Now.AddDays(7).Date;
                                        var isPaid = schedule.Status == "Paid";

                                        var rowClass = isOverdue ? "table-danger" : (isUpcoming ? "table-warning" : "");
                                        var statusBadgeClass = isPaid ? "bg-success" : (isOverdue ? "bg-danger" : (isUpcoming ? "bg-warning text-dark" : "bg-secondary"));
                                        var statusText = isPaid ? "Đã thanh toán" : (isOverdue ? "Quá hạn" : "Chưa thanh toán");

                                        <tr class="@rowClass">
                                            <td class="px-4 fw-bold text-primary">#@schedule.OrderId</td>
                                            <td>Tháng @schedule.MonthNumber</td>
                                            <td>@schedule.DueDate.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end fw-bold text-danger">@schedule.Amount.ToString("N0") ₫</td>
                                            <td class="text-center">
                                                <span class="badge rounded-pill @statusBadgeClass">@statusText</span>
                                            </td>
                                            <td class="text-center">
                                                @if (schedule.Status == "Unpaid")
                                                {
                                                    <button class="btn btn-sm btn-primary rounded-pill px-3" onclick="alert('Chức năng thanh toán đang được phát triển!')">Thanh toán</button>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
