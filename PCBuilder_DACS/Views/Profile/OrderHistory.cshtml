@model IEnumerable<PCBuilder_DACS.Models.Order>
@{
    ViewData["Title"] = "Lịch Sử Đơn Hàng";
}

@section Styles {
    <style>
        .order-page-header {
            background: linear-gradient(135deg, #0065FF 0%, #003daa 100%);
            border-radius: 16px;
            padding: 2rem 2.5rem;
            margin-bottom: 2rem;
            color: white;
        }

        .order-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            overflow: hidden;
        }

        .order-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        }

        .order-card-header {
            background: #f8f9fa;
            border-bottom: 1px solid #edf0f3;
            padding: 1rem 1.5rem;
        }

        .order-card-body {
            padding: 1.25rem 1.5rem;
        }

        .product-thumb {
            width: 64px;
            height: 64px;
            object-fit: contain;
            border-radius: 10px;
            background: #f4f7f9;
            border: 1px solid #e9ecef;
            padding: 4px;
        }

        .product-thumb-placeholder {
            width: 64px;
            height: 64px;
            border-radius: 10px;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #adb5bd;
            font-size: 1.4rem;
            border: 1px solid #dee2e6;
        }

        .more-items-badge {
            width: 64px;
            height: 64px;
            border-radius: 10px;
            background: #e8f0fe;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0065FF;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid #c8d8ff;
        }

        .total-amount {
            font-size: 1.25rem;
            font-weight: 700;
            color: #e30019;
            white-space: nowrap;
        }

        .order-id-text {
            font-weight: 700;
            color: #0065FF;
            font-size: 1rem;
        }

        .order-date-text {
            color: #6c757d;
            font-size: 0.85rem;
        }

        .empty-state {
            background: white;
            border-radius: 16px;
            padding: 4rem 2rem;
            text-align: center;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }

        .back-btn {
            background: rgba(255,255,255,0.2);
            border: 1.5px solid rgba(255,255,255,0.5);
            color: white;
            border-radius: 8px;
            padding: 0.4rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            transition: background 0.2s;
        }

        .back-btn:hover {
            background: rgba(255,255,255,0.35);
            color: white;
        }

        .order-count-badge {
            background: rgba(255,255,255,0.25);
            border-radius: 50px;
            padding: 0.3rem 0.85rem;
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* === TASK 4: Review section trong order === */
        .order-detail-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.6rem 0;
            border-bottom: 1px dashed #eee;
        }
        .order-detail-row:last-child { border-bottom: none; }

        .btn-review-product {
            font-size: 0.75rem;
            padding: 3px 10px;
            border-radius: 20px;
            border: 1.5px solid #0065FF;
            color: #0065FF;
            background: transparent;
            font-weight: 600;
            white-space: nowrap;
            text-decoration: none;
            transition: all 0.18s;
        }
        .btn-review-product:hover {
            background: #0065FF;
            color: white;
        }

        .order-items-collapse-btn {
            background: none;
            border: none;
            color: #0065FF;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            padding: 0;
            text-decoration: underline;
        }

        /* ── Pay Now pulse ── */
        .pv-pay-pulse {
            animation: pay-pulse 1.8s ease-in-out infinite;
        }
        @@keyframes pay-pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(220,53,69,.5); }
            50%       { box-shadow: 0 0 0 7px rgba(220,53,69,0); }
        }
    </style>
}

<div class="container py-4">

    <%-- Page Header --%>
    <div class="order-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="mb-1 fw-bold">
                <i class="bi bi-bag-check me-2"></i>Lịch Sử Đơn Hàng
            </h2>
            <p class="mb-0 opacity-75" style="font-size:0.9rem;">Theo dõi trạng thái tất cả bộ PC bạn đã đặt mua</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="order-count-badge">
                <i class="bi bi-box-seam me-1"></i> @Model.Count() đơn hàng
            </span>
            <a asp-action="Index" class="back-btn">
                <i class="bi bi-person-circle me-1"></i>Tài khoản
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-bag-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted fw-semibold">Chưa có đơn hàng nào</h4>
            <p class="text-muted mb-4">Hãy khám phá các linh kiện và xây dựng bộ PC mơ ước của bạn!</p>
            <a href="/Home/BuildPC" class="btn btn-primary px-4 rounded-pill">
                <i class="bi bi-tools me-2"></i>Xây Dựng Cấu Hình Ngay
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                <div class="order-card card">
                    <%-- Card Header: Order ID, Date, Status --%>
                    <div class="order-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="order-id-text"><i class="bi bi-hash"></i>@order.OrderId</span>
                            <span class="order-date-text">
                                <i class="bi bi-calendar3 me-1"></i>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                        <div>
                            @switch (order.Status)
                            {
                                case "Pending":
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>Chờ xử lý
                                        </span>
                                        @if ((DateTime.Now - order.OrderDate).TotalHours <= 24)
                                        {
                                            <form asp-action="CancelOrder" asp-controller="Profile" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@order.OrderId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không? Việc này không thể hoàn tác.');">
                                                    <i class="bi bi-x-circle me-1"></i>Hủy đơn
                                                </button>
                                            </form>
                                        }
                                        <a href="/Cart" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold pv-pay-pulse">
                                            <i class="bi bi-credit-card-fill me-1"></i>THANH TOÁN NGAY
                                        </a>
                                    </div>
                                    break;
                                case "Shipping":
                                    <span class="badge bg-primary fs-6 px-3 py-2">
                                        <i class="bi bi-truck me-1"></i>Đang giao
                                    </span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-success fs-6 px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>Hoàn thành
                                    </span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger fs-6 px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i>Đã hủy
                                    </span>
                                    break;
                                case "Returned":
                                    <span class="badge bg-secondary fs-6 px-3 py-2">
                                        <i class="bi bi-arrow-return-left me-1"></i>Đã trả hàng
                                    </span>
                                    break;
                                default:
                                    <span class="badge bg-secondary fs-6 px-3 py-2">@order.Status</span>
                                    break;
                            }
                        </div>
                    </div>

                    <%-- Card Body: Thumbnails + Total --%>
                    <div class="order-card-body">
                        @{
                            var items = order.OrderDetails.ToList();
                            var displayItems = items.Take(4).ToList();
                            var extraCount = items.Count - 4;
                            bool isCompleted = order.Status == "Completed";
                        }

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (!displayItems.Any())
                                {
                                    <div class="product-thumb-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var item in displayItems)
                                    {
                                        <div title="@item.Product?.ProductName">
                                            @{
                                                string rawPath = item.Product?.ImagePath ?? "";
                                                string resolvedImage = (rawPath.StartsWith("http://") || rawPath.StartsWith("https://"))
                                                    ? rawPath
                                                    : (string.IsNullOrEmpty(rawPath) ? Url.Content("~/images/default.png") : Url.Content("~/images/" + rawPath));
                                            }
                                            <img src="@resolvedImage"
                                                 alt="@item.Product?.ProductName"
                                                 class="product-thumb"
                                                 onerror="this.onerror=null; this.src='@Url.Content("~/images/default.png")';" />
                                        </div>
                                    }
                                    @if (extraCount > 0)
                                    {
                                        <div class="more-items-badge">+@extraCount</div>
                                    }
                                }
                                <div class="ms-2">
                                    <div class="fw-semibold" style="font-size:0.9rem; color:#212529;">
                                        @items.Count linh kiện
                                    </div>
                                    <div class="text-muted" style="font-size:0.78rem; max-width:300px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        @string.Join(", ", items.Take(3).Select(i => i.Product?.ProductName ?? "Sản phẩm"))
                                        @if (items.Count > 3) { <span>...</span> }
                                    </div>
                                </div>
                            </div>

                            <div class="text-end">
                                @if (order.DiscountAmount > 0)
                                {
                                    <div class="text-muted mb-1" style="font-size:0.8rem;">Tạm tính: <span class="text-decoration-line-through">@((order.TotalAmount + order.DiscountAmount).ToString("N0")) ₫</span></div>
                                    <div class="text-success small fw-semibold mb-1">🎁 Giảm thành viên: -@order.DiscountAmount.ToString("N0") ₫</div>
                                }
                                else
                                {
                                    <div class="text-muted mb-1" style="font-size:0.8rem;">Tổng thanh toán</div>
                                }
                                <div class="total-amount">@order.TotalAmount.ToString("N0") ₫</div>
                                @if (order.IsPointsAwarded)
                                {
                                    int pts = (int)(order.TotalAmount / 100000);
                                    <div class="mt-1" style="font-size:0.75rem; color:#0065FF;"><i class="bi bi-star-fill me-1"></i>+@pts PC Points đã cộng</div>
                                }
                            </div>
                        </div>

                        @* === TASK 4: Nút đánh giá - chỉ hiện khi đơn Completed === *@
                        @if (isCompleted && items.Any())
                        {
                            <div class="border-top pt-3 mt-1">
                                <button class="order-items-collapse-btn mb-2"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#reviewItems-@order.OrderId"
                                        aria-expanded="false">
                                    <i class="bi bi-star me-1 text-warning"></i>Đánh giá sản phẩm trong đơn này
                                    <i class="bi bi-chevron-down ms-1"></i>
                                </button>
                                <div class="collapse" id="reviewItems-@order.OrderId">
                                    <div class="ps-2">
                                        @foreach (var item in items)
                                        {
                                            <div class="order-detail-row">
                                                @{
                                                    string rawPath = item.Product?.ImagePath ?? "";
                                                    string resolvedImage = (rawPath.StartsWith("http://") || rawPath.StartsWith("https://"))
                                                        ? rawPath
                                                        : (string.IsNullOrEmpty(rawPath) ? Url.Content("~/images/default.png") : Url.Content("~/images/" + rawPath));
                                                }
                                                <img src="@resolvedImage" style="width:40px; height:40px; object-fit:contain; border-radius:8px; background:#f8f9fa; border:1px solid #eee;"
                                                     onerror="this.onerror=null; this.src='@Url.Content("~/images/default.png")';" />
                                                <div class="flex-grow-1 small fw-semibold text-truncate">
                                                    @(item.Product?.ProductName ?? "Sản phẩm")
                                                </div>
                                                <a href="/Product/Details/@item.ProductId#review-form"
                                                   class="btn-review-product">
                                                    <i class="bi bi-star-half me-1"></i>Đánh giá
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>
