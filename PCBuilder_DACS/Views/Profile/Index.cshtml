@model PCBuilder_DACS.Models.ApplicationUser
@{
    ViewData["Title"] = "Trang Cá Nhân";

    // Tier thresholds
    int[] thresholds = { 0, 500, 2000, 5000 };
    string[] tierNames = { "Đồng", "Bạc", "Vàng", "Kim Cương" };
    string[] tierIcons = { "🥉", "🥈", "🥇", "💎" };

    int tierIdx = (int)Model.Tier;
    int nextTierIdx = Math.Min(tierIdx + 1, 3);

    int currentMilestone = thresholds[tierIdx];
    int nextMilestone    = thresholds[nextTierIdx];

    double progressPct = (tierIdx == 3)
        ? 100
        : Math.Min(100, (Model.TotalPoints - currentMilestone) * 100.0 / (nextMilestone - currentMilestone));

    string cardGradient = Model.Tier switch {
        PCBuilder_DACS.Models.MembershipTier.Silver  => "linear-gradient(135deg,#5c6370 0%,#a8a9ad 50%,#6e6e6e 100%)",
        PCBuilder_DACS.Models.MembershipTier.Gold    => "linear-gradient(135deg,#b8860b 0%,#f7c948 50%,#e08b00 100%)",
        PCBuilder_DACS.Models.MembershipTier.Diamond => "linear-gradient(135deg,#0052cc 0%,#00c6ff 50%,#0072ff 100%)",
        _                                            => "linear-gradient(135deg,#5c3b1e 0%,#cd7f32 50%,#a0522d 100%)"
    };
    string glowColor = Model.Tier switch {
        PCBuilder_DACS.Models.MembershipTier.Silver  => "rgba(168,169,173,0.5)",
        PCBuilder_DACS.Models.MembershipTier.Gold    => "rgba(247,201,72,0.5)",
        PCBuilder_DACS.Models.MembershipTier.Diamond => "rgba(0,198,255,0.5)",
        _                                            => "rgba(205,127,50,0.4)"
    };
    string barColor = Model.Tier switch {
        PCBuilder_DACS.Models.MembershipTier.Silver  => "#a8a9ad",
        PCBuilder_DACS.Models.MembershipTier.Gold    => "#f7c948",
        PCBuilder_DACS.Models.MembershipTier.Diamond => "#00c6ff",
        _                                            => "#cd7f32"
    };
}

@section Styles {
<style>
    .membership-card {
        background: @cardGradient;
        border-radius: 20px;
        padding: 32px 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 40px @glowColor, 0 2px 12px rgba(0,0,0,0.18);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .membership-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 56px @glowColor, 0 4px 20px rgba(0,0,0,0.22);
    }
    .membership-card::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 200px; height: 200px;
        background: rgba(255,255,255,0.08);
        border-radius: 50%;
    }
    .membership-card::after {
        content: '';
        position: absolute;
        bottom: -40px; left: -40px;
        width: 150px; height: 150px;
        background: rgba(255,255,255,0.05);
        border-radius: 50%;
    }
    .tier-icon-big { font-size: 3.5rem; line-height: 1; }
    .progress-bar-loyalty {
        height: 10px;
        border-radius: 8px;
        background: rgba(255,255,255,0.2);
        overflow: hidden;
    }
    .progress-bar-loyalty-fill {
        height: 100%;
        border-radius: 8px;
        background: #fff;
        transition: width 0.8s ease;
        box-shadow: 0 0 8px rgba(255,255,255,0.7);
    }
    .stat-pill {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(6px);
        border-radius: 12px;
        padding: 12px 20px;
        text-align: center;
    }
    .benefit-row { background: rgba(255,255,255,0.1); border-radius: 10px; padding: 8px 14px; margin-bottom: 6px; font-size: 0.88rem; }
</style>
}

<div class="container py-5" style="max-width:820px;">
    <h3 class="fw-bold mb-4">
        <i class="bi bi-person-badge-fill text-primary me-2"></i>Trang Cá Nhân
    </h3>

    <!-- ── Membership Card ── -->
    <div class="membership-card mb-4">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
            <div>
                <div class="tier-icon-big mb-1">@tierIcons[tierIdx]</div>
                <div style="font-size:1.6rem; font-weight:800; letter-spacing:-0.5px;">Hạng @tierNames[tierIdx]</div>
                <div style="font-size:0.85rem; opacity:0.8; margin-top:2px;">PC Builder AI Member Card</div>
                <div style="font-size:1rem; font-weight:600; margin-top:6px; opacity:0.9;">@User.Identity!.Name</div>
            </div>
            <div class="text-end" style="position:relative; z-index:1;">
                <div class="stat-pill mb-2">
                    <div style="font-size:1.8rem; font-weight:800;">@Model.CurrentPoints</div>
                    <div style="font-size:0.75rem; opacity:0.85;">Điểm hiện có</div>
                </div>
                <div class="stat-pill">
                    <div style="font-size:1.8rem; font-weight:800;">@Model.TotalPoints</div>
                    <div style="font-size:0.75rem; opacity:0.85;">Tổng điểm tích lũy</div>
                </div>
            </div>
        </div>

        <!-- Progress Bar -->
        <div class="mt-4" style="position:relative; z-index:1;">
            @if (tierIdx < 3)
            {
                <div class="d-flex justify-content-between mb-1" style="font-size:0.8rem; opacity:0.9;">
                    <span>@tierIcons[tierIdx] @tierNames[tierIdx]</span>
                    <span>@Model.TotalPoints / @nextMilestone điểm</span>
                    <span>@tierIcons[nextTierIdx] @tierNames[nextTierIdx]</span>
                </div>
                <div class="progress-bar-loyalty">
                    <div class="progress-bar-loyalty-fill" style="width:@progressPct.ToString("F1")%;"></div>
                </div>
                <div class="mt-2" style="font-size:0.82rem; opacity:0.85; text-align:center;">
                    Còn <strong>@(nextMilestone - Model.TotalPoints) điểm</strong> nữa để lên Hạng @tierNames[nextTierIdx] @tierIcons[nextTierIdx]
                </div>
            }
            else
            {
                <div class="progress-bar-loyalty">
                    <div class="progress-bar-loyalty-fill" style="width:100%;"></div>
                </div>
                <div class="mt-2" style="font-size:0.82rem; opacity:0.9; text-align:center;">
                    💎 Bạn đã đạt cấp độ cao nhất — <strong>Kim Cương</strong>!
                </div>
            }
        </div>

        <!-- Privileges -->
        <div class="mt-4" style="position:relative; z-index:1;">
            <div style="font-size:0.78rem; opacity:0.75; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Đặc quyền của bạn</div>
            @switch (Model.Tier)
            {
                case PCBuilder_DACS.Models.MembershipTier.Silver:
                    <div class="benefit-row">🎁 Giảm <strong>2%</strong> cho mọi đơn hàng</div>
                    break;
                case PCBuilder_DACS.Models.MembershipTier.Gold:
                    <div class="benefit-row">🎁 Giảm <strong>5%</strong> cho mọi đơn hàng</div>
                    break;
                case PCBuilder_DACS.Models.MembershipTier.Diamond:
                    <div class="benefit-row">🎁 Giảm <strong>10%</strong> mỗi đơn (tối đa 1.000.000 ₫)</div>
                    break;
                default:
                    <div class="benefit-row">⭐ Tích điểm 100.000 ₫ = 1 PC Point</div>
                    <div class="benefit-row">🚀 Đạt 500 điểm để lên Hạng Bạc và nhận ưu đãi!</div>
                    break;
            }
        </div>
    </div>

    <!-- ── Info Card ── -->
    <div class="card border-0 shadow-sm" style="border-radius:16px;">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Thông tin tài khoản</h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="text-muted small">Tên đăng nhập</div>
                    <div class="fw-semibold">@Model.UserName</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">Email</div>
                    <div class="fw-semibold">@Model.Email</div>
                </div>
            </div>
            <hr class="my-3">
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Profile" asp-action="OrderHistory" class="btn btn-outline-primary btn-sm rounded-pill">
                    <i class="bi bi-bag-check me-1"></i>Lịch sử đơn hàng
                </a>
                <a asp-controller="Profile" asp-action="Installments" class="btn btn-outline-warning btn-sm rounded-pill">
                    <i class="bi bi-calendar3 me-1"></i>Lịch trả góp
                </a>
            </div>
        </div>
    </div>

    <!-- ── Tier Guide ── -->
    <div class="card border-0 shadow-sm mt-3" style="border-radius:16px;">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-award text-warning me-2"></i>Bảng xếp hạng thành viên</h6>
            <div class="row g-2 text-center">
                @{
                    string[] tgColors = { "#cd7f32", "#a8a9ad", "#f7c948", "#00c6ff" };
                    string[] tgDesc   = { "0 điểm", "500 điểm — Giảm 2%", "2.000 điểm — Giảm 5%", "5.000 điểm — Giảm 10%" };
                }
                @for (int i = 0; i < 4; i++)
                {
                    bool active = (i == tierIdx);
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 h-100" style="border:2px solid @(active ? tgColors[i] : "#eee"); background:@(active ? tgColors[i]+"18" : "#fafafa");">
                            <div style="font-size:1.8rem;">@tierIcons[i]</div>
                            <div class="fw-bold small" style="color:@tgColors[i];">@tierNames[i]</div>
                            <div class="text-muted" style="font-size:0.72rem;">@tgDesc[i]</div>
                            @if (active) { <span class="badge mt-1" style="background:@tgColors[i]; font-size:0.65rem;">Hạng hiện tại</span> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
