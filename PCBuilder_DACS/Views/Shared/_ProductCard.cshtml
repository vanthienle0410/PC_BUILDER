@model PCBuilder_DACS.Models.Product

@{
    string badgeText = ViewData["Badge"] as string;
    string badgeColor = ViewData["BadgeColor"] as string ?? "danger";
    // Support both CDN absolute URLs (Phong Vu) and local relative paths
    string rawPath = Model.ImagePath ?? "";
    string resolvedImage = (rawPath.StartsWith("http://") || rawPath.StartsWith("https://"))
        ? rawPath
        : (string.IsNullOrEmpty(rawPath) ? "/images/default.png" : "/images/" + rawPath);
}

<div class="card h-100 product-card position-relative border-0 rounded-3">
    @if (!string.IsNullOrEmpty(badgeText))
    {
        <span class="product-badge badge bg-@badgeColor position-absolute top-0 start-0 m-2 shadow-sm rounded-pill px-3 py-2 fw-bold" style="z-index: 2; font-size: 0.75rem;">
            @if (badgeText == "AI Pick") { <i class="bi bi-robot me-1"></i> }
            else if (badgeText == "Mới") { <i class="bi bi-stars me-1"></i> }
            else if (badgeText == "Hot") { <i class="bi bi-fire me-1 text-danger"></i> }
            @badgeText
        </span>
    }
    
    <div class="product-img-wrapper p-3 text-center position-relative overflow-hidden">
        @if (Model.Price > 10000000)
        {
            <span class="product-badge badge bg-warning text-dark position-absolute top-0 end-0 m-2 shadow-sm rounded-pill px-3 py-2 fw-bold" style="z-index: 2; font-size: 0.75rem;">
                <i class="bi bi-credit-card me-1"></i>Trả Góp 0%
            </span>
        }
        <a href="/Product/Details/@Model.ProductId">
            <img src="@resolvedImage"
                 class="card-img-top img-fluid product-img transition-zoom"
                 alt="@Model.ProductName"
                 onerror="this.onerror=null; this.src='https://placehold.co/300x300/f8f9fa/a1a1aa?text=No+Image'; this.style.padding='20px';">
        </a>
        
        <!-- Quick Action Overlay -->
        <div class="product-action-overlay position-absolute bottom-0 w-100 pb-3 opacity-0 d-flex justify-content-center gap-2">
            <button class="btn btn-primary btn-sm rounded-circle shadow d-flex align-items-center justify-content-center" title="Thêm vào giỏ hàng" style="width: 42px; height: 42px;">
                <i class="bi bi-cart-plus fs-5"></i>
            </button>
            <a href="/Product/Details/@Model.ProductId" class="btn btn-light btn-sm rounded-circle shadow d-flex align-items-center justify-content-center" title="Xem chi tiết" style="width: 42px; height: 42px; border: 1px solid #dee2e6;">
                <i class="bi bi-eye fs-5 text-dark"></i>
            </a>
        </div>
    </div>
    
    <div class="card-body d-flex flex-column px-3 pt-2 pb-3">
        <p class="mb-1 text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">
            <i class="bi bi-tag-fill me-1 text-secondary"></i> @(Model.Brand ?? "PC Builder")
        </p>
        
        <a href="/Product/Details/@Model.ProductId" class="text-decoration-none">
            <h6 class="card-title fw-bold text-dark mb-2 product-title-truncate" title="@Model.ProductName">
                @Model.ProductName
            </h6>
        </a>
        
        <div class="mt-auto">
            <p class="product-price-text fs-5 fw-bold mb-0">@((Model.Price ?? 0).ToString("N0")) <span class="fs-6 text-decoration-underline small align-top text-muted">đ</span></p>
            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top border-light">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2" style="font-size: 0.7rem;">
                    <i class="bi bi-check-circle-fill me-1"></i>Còn hàng
                </span>
                <div class="text-warning small" style="font-size: 0.75rem;">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-half"></i>
                </div>
            </div>
        </div>
    </div>
</div>
